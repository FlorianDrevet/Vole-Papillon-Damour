# Copier en .env.local (ignoré par git) et compléter.
# Tutoriel : docs/recommandations-livres/06-tutoriel-foundry-embeddings.md

# Point d'accès du compte Azure OpenAI / Foundry (Portail > compte > Clés et point de terminaison)
AZURE_OPENAI_ENDPOINT=https://<nom-du-compte>.openai.azure.com/

# Nom du DÉPLOIEMENT (pas du modèle) créé à l'étape 3 du tutoriel
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Laisser vide : l'authentification passe par Microsoft Entra ID (az login).
# Le compte du projet a l'authentification par clé désactivée (disableLocalAuth).
AZURE_OPENAI_API_KEY=
