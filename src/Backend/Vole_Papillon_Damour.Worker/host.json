{
  "version": "2.0",
  "functionTimeout": "1.00:00:00",
  "telemetryMode": "OpenTelemetry",
  "logging": {
    "logLevel": {
      "default": "Warning",
      "Host.Aggregator": "Warning",
      "Host.Results": "Information",
      "Function.Enrich.User": "Information",
      "Function.ResumeEnrich.User": "Information",
      "Function.EnrichCatalogBatch.User": "Information",
      "Function.Sweep.User": "Information",
      "Function.IsbndbCatchUp.User": "Information",
      "Function.IsbndbCatchUpManual.User": "Information",
      "Function.RecommendationsBackfill.User": "Information",
      "Function.ProcessBookRecommendations.User": "Information",
      "Function.ImportSocialActualities.User": "Information"
    }
  },
  "extensions": {
    "queues": {
      "messageEncoding": "base64",
      "batchSize": 1,
      "newBatchThreshold": 0,
      "maxDequeueCount": 5,
      "visibilityTimeout": "00:05:00"
    }
  }
}
