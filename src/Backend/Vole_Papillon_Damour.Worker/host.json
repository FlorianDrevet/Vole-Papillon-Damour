{
  "version": "2.0",
  "telemetryMode": "OpenTelemetry",
  "logging": {
    "logLevel": {
      "default": "Information",
      "Host.Aggregator": "Warning"
    }
  },
  "extensions": {
    "queues": {
      "messageEncoding": "base64",
      "batchSize": 1,
      "newBatchThreshold": 0,
      "maxDequeueCount": 5,
      "visibilityTimeout": "00:05:00"
    }
  }
}
