      "firstName": "Alice",
      "lastName": "Bénévole Tri",
      "attributes": {
        "oid": ["10000000-0000-4000-8000-000000000002"]
      },
      "credentials": [
        { "type": "password", "value": "VpdLocalDev!2026", "temporary": false }
      ],
      "clientRoles": {
        "vpd-api": ["Tri"]
      }
    },
    {
      "username": "local-caisse",
      "email": "benoit.caisse@vpd.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Benoît",
      "lastName": "Caisse",
      "attributes": {
        "oid": ["10000000-0000-4000-8000-000000000003"]
      },
      "credentials": [
        { "type": "password", "value": "VpdLocalDev!2026", "temporary": false }
      ],
      "clientRoles": {
        "vpd-api": ["Caisse"]
      }
    },
    {
      "username": "local-member",
      "email": "membre@vpd.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Élodie",
      "lastName": "Adhérente",
      "attributes": {
        "oid": ["10000000-0000-4000-8000-000000000004"]
      },
      "credentials": [
        { "type": "password", "value": "VpdLocalDev!2026", "temporary": false }
      ],
      "clientRoles": {
        "vpd-api": []
      }
    }
  ]
}
