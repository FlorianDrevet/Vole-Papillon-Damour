{
  "realm": "vpd",
  "displayName": "Vole Papillon d'Amour (local)",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "vpd-api",
      "name": "VPD API",
      "protocol": "openid-connect",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "vpd-local-test",
      "name": "VPD local API test client",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": ["profile", "email", "vpd-api-access"]
    },
    {
      "clientId": "vpd-backoffice-local",
      "name": "VPD BackOffice local browser",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["vpd-api-access"]
    }
  ],
  "clientScopes": [
    {
      "name": "vpd-api-access",
      "description": "Local API audience, external member id, and VPD application roles",
      "protocol": "openid-connect",
      "attributes": {
        "display.on.consent.screen": "false",
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "VPD external member id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "oid",
            "claim.name": "oid",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "jsonType.label": "String"
          }
        },
        {
          "name": "VPD member email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "jsonType.label": "String"
          }
        },
        {
          "name": "VPD member first name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "firstName",
            "claim.name": "given_name",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "jsonType.label": "String"
          }
        },
        {
          "name": "VPD member last name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "lastName",
            "claim.name": "family_name",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "jsonType.label": "String"
          }
        },
        {
          "name": "VPD API audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "vpd-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "VPD API roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "vpd-api",
            "claim.name": "roles",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "multivalued": "true",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "roles": {
    "client": {
      "vpd-api": [
        { "name": "Administration", "composite": false },
        { "name": "LivresRares", "composite": false },
        { "name": "Tri", "composite": false },
        { "name": "Caisse", "composite": false }
      ]
    }
  },
  "users": [
    {
      "username": "local-admin",
      "email": "admin@vpd.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Camille",
      "lastName": "Administratrice",
      "attributes": {
        "oid": ["10000000-0000-4000-8000-000000000001"]
      },
