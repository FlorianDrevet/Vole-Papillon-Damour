    "titre-membre": {
      "x": 0,
      "y": -320,
      "text": "Ma sélection : un signalement plutôt que quatre états",
      "kind": "title1",
      "maxW": 2960,
      "page": "membre"
    },
    "note-bouton": {
      "x": 0,
      "y": -200,
      "w": 440,
      "size": "m",
      "fill": "orange",
      "page": "membre",
      "text": "Le bouton « Je ne l'ai pas trouvé » n'apparaît que sur une ligne Disponible et non achetée. Annoncé, épuisé, fiche vendue ou acheté : pas de bouton. Le sélecteur À prendre / Acheté / Pas trouvé / À revoir disparaît (spec §6, RG-76)."
    },
    "note-merci": {
      "x": 520,
      "y": -200,
      "w": 440,
      "size": "m",
      "fill": "blue",
      "page": "membre",
      "text": "Ton de remerciement, jamais de réclamation. Après clôture, la ligne dit ce qui s'est passé : retrouvé en rayon, ou retiré après le signalement."
    },
    "titre-admin": {
      "x": 0,
      "y": -320,
      "text": "Administration : une file de vérification",
      "kind": "title1",
      "maxW": 3430,
      "page": "admin"
    },
    "note-file": {
      "x": 0,
      "y": -200,
      "w": 460,
      "size": "m",
      "fill": "orange",
      "page": "admin",
      "text": "Nouvelle entrée « Livres introuvables » dans « Pendant la bourse », juste après Désengorgement. Une ligne = une fiche, signalements regroupés, aucune identité de membre (RG-74)."
    },
    "note-retrait": {
      "x": 540,
      "y": -200,
      "w": 460,
      "size": "m",
      "fill": "teal",
      "page": "admin",
      "text": "On demande combien d'exemplaires sont PRÉSENTS, pas combien retirer : le stock est par ISBN, un signalement ne dit pas quel exemplaire manque. Le retrait réutilise le mouvement RETRAIT existant."
    }
